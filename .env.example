# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENV=dev                                  # dev | prod
SECRET_KEY=change-me-32-bytes-min        # JWT signing key
OTP_HMAC_SECRET=change-me-another-secret # used to hash OTP codes at rest
TZ_DEFAULT=Asia/Tehran

# --- Database ---
# In docker-compose the host is "db"; for local runs use localhost.
DATABASE_URL=postgresql+asyncpg://friendship:friendship@db:5432/friendship
POSTGRES_USER=friendship
POSTGRES_PASSWORD=friendship
POSTGRES_DB=friendship

# --- Sessions ---
ACCESS_TTL_SECONDS=1800                  # 30 min
REFRESH_TTL_SECONDS=2592000             # 30 days (sliding)
REFRESH_ABSOLUTE_TTL_SECONDS=7776000    # 90 days (hard cap)
COOKIE_SECURE=false                      # true in prod (HTTPS only)
COOKIE_DOMAIN=

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173    # used to build invite links

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_PER_HOUR=5

# --- SMS provider ---
SMS_PROVIDER=console                     # console | kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --- Email provider ---
EMAIL_PROVIDER=console                   # console | smtp
EMAIL_FROM=Friendship <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Web Push (VAPID) ---
# Generate once:  python -m app.scripts.gen_vapid   (prints a keypair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Birthday reminders ---
# Comma-separated "days_before:HH:MM" windows (local time of the birthday user).
REMINDER_OFFSETS=7:09:00,3:09:00,1:21:00,0:09:00
